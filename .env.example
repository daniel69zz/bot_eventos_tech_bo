# Copia este archivo a .env y completá tus valores (para correr local).

# --- Serper (https://serper.dev) — resultados de Google, busca toda la web ---
SERPER_API_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- LLM (compatible OpenAI). Por defecto: Groq (tiene capa gratis generosa) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
